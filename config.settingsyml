schema: 1
base:
  name: test
  version: "1.0"
  hostname: user
  arch: x86_64
kernel:
  version: "6.12"
  preset: desktop
  features:
    - bpf
  config: {}
boot:
  loader: systemd-boot
  firmware: uefi
init:
  system: systemd
userland:
  libc: glibc
  coreutils: gnu
  shell: bash
packages:
  manager: pacman
  browser: firefox
  terminal: kitty
  editor: neovim
  extra:
    - git
    - htop
    - gcc
    - make
    - python
desktop:
  environment: hyprland
  display: wayland
  login: sddm
image:
  installer: calamares
